{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LangFixer",
  "version": "1.0.0",
  "identifier": "com.langfixer.desktop",
  "build": {
    "frontendDist": "../web-ui/dist",
    "devUrl": "http://localhost:4805",
    "beforeDevCommand": "bash ../scripts/ensure-vite.sh",
    "beforeBuildCommand": "npm --prefix ../web-ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "LangFixer",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#f2f3f8",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCRjg5RjM2OTdBNzQzNDEKUldSQlE2ZVhOcC80S3lFaGVqbUp5c3UvQituN29BYjlWS0s5RXJzc3dKdGgrK0xNcnI2N3BLbUwK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

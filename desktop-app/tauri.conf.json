{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LangFixer",
  "version": "0.1.0",
  "identifier": "com.langfixer.desktop",
  "build": {
    "frontendDist": "../web-ui/dist",
    "devUrl": "http://localhost:4805"
  },
  "app": {
    "windows": [
      {
        "title": "LangFixer",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#f2f3f8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

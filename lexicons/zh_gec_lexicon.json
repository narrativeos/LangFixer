{
  "categories": [
    {
      "id": "spelling",
      "name": "拼写/用字"
    },
    {
      "id": "grammar",
      "name": "语法"
    },
    {
      "id": "typography",
      "name": "标点/排版"
    },
    {
      "id": "anomaly",
      "name": "异常（AI 文本污染）"
    }
  ],
  "rules": [
    {
      "id": "ZH_CONFUSABLE",
      "category": "spelling",
      "priority": 10,
      "enabled": true,
      "description": "同音/形近错别字与繁简混用；条目可附 condition（邻接 POS/文本白名单、周边窗口正则），条件满足才触发（出厂启用：误报由 condition / 排除词 / 人工勾选收敛）",
      "examples": [
        {
          "wrong": "他時常迟到",
          "right": "他时常迟到"
        },
        {
          "wrong": "他的态度很岐",
          "right": "他的态度很歧"
        },
        {
          "wrong": "他好象很高兴",
          "right": "他好像很高兴"
        }
      ]
    },
    {
      "id": "ZH_DE_DA_DE",
      "category": "grammar",
      "priority": 10,
      "enabled": true,
      "description": "「的/地/得」误用（需 POS；无 NLP 服务时该规则不产出）",
      "examples": [
        {
          "wrong": "他的高兴笑",
          "right": "他高兴地笑"
        }
      ]
    },
    {
      "id": "ZH_PUNCTUATION",
      "category": "typography",
      "priority": 5,
      "enabled": true,
      "description": "中英文标点混用",
      "examples": [
        {
          "wrong": "今天,天气很好.",
          "right": "今天，天气很好。"
        }
      ],
      "excludes": [
        "——",
        "）、"
      ]
    },
    {
      "id": "ZH_MISSING_SUBJECT",
      "category": "grammar",
      "priority": 8,
      "enabled": true,
      "description": "句子成分残缺（缺主语；需 POS，句首动词触发；误报进 excludes 名单）",
      "examples": [
        {
          "wrong": "学习。",
          "right": "他学习。"
        }
      ],
      "excludes": [
        "靠"
      ]
    },
    {
      "id": "ZH_ANOMALY_ASSISTANT_REPLY",
      "category": "anomaly",
      "priority": 20,
      "enabled": true,
      "description": "AI 助手回复/元讨论混入正文（服务性问句、修改指令、套话）；引号内对话不触发",
      "examples": [
        {
          "wrong": "需要我再微调部分语句，让整体文风更贴合悬疑灵异的氛围吗?",
          "right": ""
        }
      ],
      "patterns": [
        {
          "pattern": "^(需要|要不要|是否要|需不需要)我.{0,80}[?？]",
          "strong": true,
          "note": "「需要我再……吗？」服务性问句"
        },
        {
          "pattern": "^我(可以|能|想|要|来|建议)(帮你|为你|替你|再).{0,80}[?？]",
          "strong": true,
          "note": "「我可以帮你……吗？」服务性问句"
        },
        {
          "pattern": "^(如需|如果需要|若需|需要的话).{0,60}(请|告诉|说|回复).{0,40}[?？。！!]",
          "strong": true,
          "note": "「如需进一步修改，请告诉我」类收尾话术"
        },
        {
          "pattern": "^(以下是|这是|上面是)(修改|调整|优化|润色|改写)后的.{0,20}(版本|内容|文本|章节)",
          "strong": true,
          "note": "「以下是修改后的版本」类元说明"
        },
        {
          "pattern": "^好的[，,]?我(已经|已|帮你|为你|将).{0,60}[。！!？?]",
          "strong": true,
          "note": "「好的，我已经帮你……」类确认话术"
        },
        {
          "pattern": "^(需要|要不要|是否|能否|可以|想).{0,80}(文风|语句|段落|章节|润色|微调|改写|修改|优化|调整).{0,40}[?？]",
          "strong": false,
          "note": "服务性问句 + 元语言词汇"
        },
        {
          "pattern": "^我(觉得|认为|想|要|建议|可以|能).{0,40}(文风|语句|段落|章节|润色|微调|改写|修改|优化|调整).{0,40}[?？]",
          "strong": false,
          "note": "第一人称服务性问句 + 元语言词汇"
        }
      ]
    },
    {
      "id": "ZH_SPELL",
      "category": "spelling",
      "priority": 10,
      "enabled": true,
      "description": "同音词误用（学习产物）：「报复」→「抱负」（如「有报复」应为「有抱负」）；需 condition 上下文约束防「报复社会」等合法用法误伤",
      "examples": [
        {
          "wrong": "报复",
          "right": "抱负"
        }
      ]
    },
    {
      "id": "ZH_TIME_MIX",
      "category": "grammar",
      "priority": 7,
      "enabled": true,
      "description": "12/24 小时制混用：时段词（上午/下午/中午/晚上/凌晨）与 13-23 点并存，时间表达重复；不改变原时间，两种写法择一",
      "examples": [
        {
          "wrong": "请买下午15点以后的车票。",
          "right": "请买15点以后的车票。"
        },
        {
          "wrong": "上午20点集合。",
          "right": "20点集合。"
        }
      ]
    },
    {
      "id": "ZH_COLON_AFTER_NAME",
      "category": "typography",
      "priority": 6,
      "enabled": true,
      "description": "名称（小程序/公众号/网址/二维码等）后误用冒号作提示性停顿；参照 GB/T 15834—2011 附录 A.6.3，宜删冒号并用引号标明名称",
      "examples": [
        {
          "wrong": "微信小程序：掌上阜外医院",
          "right": "微信小程序“掌上阜外医院”"
        }
      ]
    }
  ],

  "categories": [
    {
      "id": "grammar",
      "name": "语法"
    },
    {
      "id": "style",
      "name": "风格"
    },
    {
      "id": "spelling",
      "name": "拼写"
    }
  ],
  "rules": [
    {
      "id": "EN_ARTICLE",
      "category": "grammar",
      "priority": 10,
      "enabled": true,
      "description": "冠词 a/an 误用",
      "examples": [
        {
          "wrong": "I saw a apple.",
          "right": "I saw an apple."
        }
      ]
    },
    {
      "id": "EN_AGREEMENT",
      "category": "grammar",
      "priority": 10,
      "enabled": true,
      "description": "主谓一致（第三人称单数 -s）",
      "examples": [
        {
          "wrong": "He play football.",
          "right": "He plays football."
        }
      ]
    },
    {
      "id": "EN_TENSE",
      "category": "grammar",
      "priority": 10,
      "enabled": true,
      "description": "时态错误（过去时间 + 动词原形）",
      "examples": [
        {
          "wrong": "Yesterday I go to the park.",
          "right": "Yesterday I went to the park."
        }
      ]
    },
    {
      "id": "EN_PREPOSITION",
      "category": "grammar",
      "priority": 8,
      "enabled": true,
      "description": "介词误用",
      "examples": [
        {
          "wrong": "I saw him on the morning.",
          "right": "I saw him in the morning."
        }
      ]
    },
    {
      "id": "EN_ADJECTIVE",
      "category": "grammar",
      "priority": 10,
      "enabled": true,
      "description": "形容词比较级/最高级误用",
      "examples": [
        {
          "wrong": "This is more better than that.",
          "right": "This is better than that."
        }
      ]
    },
    {
      "id": "EN_ADVERB",
      "category": "grammar",
      "priority": 8,
      "enabled": true,
      "description": "形副同形（实义动词后误用形容词作状语）",
      "examples": [
        {
          "wrong": "He runs slow.",
          "right": "He runs slowly."
        }
      ]
    },
    {
      "id": "EN_NOUN",
      "category": "grammar",
      "priority": 8,
      "enabled": true,
      "description": "不可数名词误用",
      "examples": [
        {
          "wrong": "I need some informations.",
          "right": "I need some information."
        }
      ]
    },
    {
      "id": "EN_PRONOUN",
      "category": "grammar",
      "priority": 8,
      "enabled": true,
      "description": "反身代词缺失",
      "examples": [
        {
          "wrong": "He hurt him yesterday.",
          "right": "He hurt himself yesterday."
        }
      ]
    },
    {
      "id": "EN_VERB_PREP",
      "category": "grammar",
      "priority": 8,
      "enabled": true,
      "description": "及物动词后多余介词",
      "examples": [
        {
          "wrong": "We discuss about it.",
          "right": "We discuss it."
        }
      ]
    },
    {
      "id": "EN_GERUND",
      "category": "grammar",
      "priority": 8,
      "enabled": true,
      "description": "后接动名词的动词误用 to-infinitive",
      "examples": [
        {
          "wrong": "I enjoy to play.",
          "right": "I enjoy playing."
        }
      ]
    },
    {
      "id": "EN_INFINITIVE",
      "category": "grammar",
      "priority": 8,
      "enabled": true,
      "description": "后接不定式的动词误用动名词",
      "examples": [
        {
          "wrong": "I want playing.",
          "right": "I want to play."
        }
      ]
    },
    {
      "id": "EN_SUBJUNCTIVE",
      "category": "grammar",
      "priority": 8,
      "enabled": true,
      "description": "虚拟语气（wish/if 后 be 动词应用 were）",
      "examples": [
        {
          "wrong": "I wish I was you.",
          "right": "I wish I were you."
        }
      ]
    },
    {
      "id": "EN_NEGATION",
      "category": "grammar",
      "priority": 8,
      "enabled": true,
      "description": "双重否定",
      "examples": [
        {
          "wrong": "I don't know nothing.",
          "right": "I don't know anything."
        }
      ]
    },
    {
      "id": "EN_SPELLING",
      "category": "spelling",
      "priority": 12,
      "enabled": true,
      "description": "拼写错误（高频错词表）",
      "examples": [
        {
          "wrong": "I dont like it.",
          "right": "I don't like it."
        },
        {
          "wrong": "This is a exemple.",
          "right": "This is an example."
        }
      ]
    }
  ],

# 评测通道服务器环境文件（systemd EnvironmentFile=/srv/langfixer/langfixer.env）
# 键语义见 docs/GATEWAY_AUTH.md；本文件是服务器落地值，chmod 600。

LANGFIXER_GATEWAY=1
# 监听 docker 网桥宿主侧地址：仅 dnmp_default 网络内的 Caddy 可达，公网与本机其他进程不可见。
# 公网入口只由 Caddy(443) 持有。若 compose 网络重建导致网关变化，用
# `docker network inspect dnmp_default -f '{{(index .IPAM.Config 0).Gateway}}'` 重新取值。
LANGFIXER_BIND=172.18.0.1
PORT=4801

# 超级管理员令牌：openssl rand -hex 32 生成，只放本文件（≥32 字符，内存仅留摘要）
LANGFIXER_ADMIN_TOKEN=REPLACE_ME_WITH_64_HEX
# 评审会话 cookie 走公网 HTTPS，保持 Secure
LANGFIXER_COOKIE_SECURE=1

# 存储全部落在 web 根之外（/dnmp/www 是 Caddy 挂载的静态根，不放数据与源码）
GEC_DB_FILE=/srv/langfixer/data/langfixer.db
LANGFIXER_AUTH_DB=/srv/langfixer/data/auth.db
GEC_TABLES_DIR=/srv/langfixer/decision-tables
GEC_LEXICONS_DIR=/srv/langfixer/lexicons
LLM_PROMPTS_DIR=/srv/langfixer/prompts

# 服务器侧不跑 HanLP、不装 8G gguf、默认不启用决策模型层
GEC_OFFLINE=1
GEC_DEC_ENABLED=0

# LLM 兜底（level 3 无条件兜底与 explain 需要；level 2 走 L3 特征模型门控）。
# 服务器实态：litellm 经 frps 隧道仅监听 127.0.0.1:4000，模型 Qwen3.8。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 数据保留天数（langfixer-retention.timer 使用，见 deploy/gateway/README.md）
LANGFIXER_RETENTION_DAYS=7

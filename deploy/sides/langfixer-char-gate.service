[Unit]
Description=LangFixer char-gate sidecar service (:4811)

[Service]
Restart=always
RestartSec=3
WorkingDirectory=/srv/langfixer/feature-model
# 默认仅绑 127.0.0.1;L3 在 docker bridge 里的机器按 README 改 CHAR_GATE_HOST/端口发布
Environment=CHAR_GATE_HOST=127.0.0.1
ExecStart=/srv/langfixer/feature-model/.venv_char/bin/python char_gate.py --port 4811

[Install]
WantedBy=multi-user.target

# LangFixer 评测通道（网关形态）配置样例——复制为 .env（.env 已在 .gitignore）
# 单机形态：默认带登录门（admin / LangFixer@2026）；设 LANGFIXER_LOGIN=0 可关掉，
# 鉴权层整体关闭，行为与接入鉴权前完全一致。

# 网关开关：1 = 公网评测形态（鉴权生效）；0/未设 = 单机形态
LANGFIXER_GATEWAY=0

# 单机登录门：1/未设 = 开启（内建 admin 账号密码，未登录业务请求回 401）；0 = 关闭回直通。
# 网关形态下本开关不参与（已有全量鉴权门，密码登录仍可用）。
LANGFIXER_LOGIN=1

# 管理员登录密码（可选）：给了以 env 为准（不进库）；不给则用库里的摘要，
# 库里也没有时以默认密码 LangFixer@2026 初始化落库。改密用 POST /auth/password。
LANGFIXER_ADMIN_PASSWORD=

# 超级管理员令牌：唯一不进数据库的凭证。
# - ≥32 字符；生成：openssl rand -hex 32
# - 仅超管 Bearer 可达 /admin/*；不是评审令牌，不占评审配额归户，永不下发 cookie
# - 泄露处置 = 改本值 + 重启（摘要在内存，改后即失效，开关即断）
LANGFIXER_ADMIN_TOKEN=

# 评审令牌与会话存储（独立于产品数据 langfixer.db，删文件即重置评测通道）
LANGFIXER_AUTH_DB=auth.db

# 反向代理（Caddy）持 TLS 时保持 1；本机 http 明文联调设 0，否则浏览器拒收 cookie
LANGFIXER_COOKIE_SECURE=1

# 网关形态建议绑 127.0.0.1，公网入口只交给 Caddy
LANGFIXER_BIND=0.0.0.0
